# Пример конфигурации Nginx для play.мир-шахмат.рф (в punycode: play.xn----8sba3atdzuy2a.xn--p1ai)
#
# Разместить рядом с существующими конфигами Lila на VPS, подставить реальные пути
# к SSL-сертификату (Let's Encrypt: certbot --nginx -d play.xn----8sba3atdzuy2a.xn--p1ai).
#
# Логика:
#   /bridge/*  -> мост тихой авторизации (bridge.py, слушает на 127.0.0.1:9321)
#   всё остальное -> сама Lila (обычно 127.0.0.1:8080, порт см. в текущем конфиге Lila)

server {
    listen 443 ssl http2;
    server_name play.xn----8sba3atdzuy2a.xn--p1ai;

    ssl_certificate     /etc/letsencrypt/live/play.xn----8sba3atdzuy2a.xn--p1ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/play.xn----8sba3atdzuy2a.xn--p1ai/privkey.pem;

    location /bridge/ {
        proxy_pass http://127.0.0.1:9321;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;

        # WebSocket — нужен для игры в реальном времени (lila-ws)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name play.xn----8sba3atdzuy2a.xn--p1ai;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
